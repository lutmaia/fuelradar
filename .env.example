# Lista JSON de UFs publicadas (lida por scripts/ingest_local.py). Mantém o raw completo.
TARGET_UFS=["SP"]

# Conexão com o PostgreSQL (lida por scripts/load_db.py). Exemplo sem segredo; o valor real
# fica só no ambiente ou em um .env local, que o Git ignora. Para o contêiner do docker-compose.yml:
# postgresql://radar:<POSTGRES_PASSWORD>@127.0.0.1:54329/radar (use 127.0.0.1, não localhost:
# no Windows o localhost tenta IPv6 primeiro e cada conexão demora cerca de 30 s).
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/radar

# Docker Compose (docker-compose.yml): senha do superusuário "radar" do contêiner postgres.
# Copie este arquivo para .env e troque o valor; nunca versione o .env.
POSTGRES_PASSWORD=troque-por-uma-senha-local
# POSTGRES_PORT=54329

# API de leitura (scripts/run_api.py): usuário somente leitura `radar_api`, criado por
# scripts/create_api_role.py com a senha de RADAR_API_PASSWORD (só para esse script, nunca versione).
# A API não usa DATABASE_URL: o usuário de escrita do pipeline não deve servir a API.
# API_DATABASE_URL=postgresql://radar_api:<RADAR_API_PASSWORD>@127.0.0.1:54329/radar
